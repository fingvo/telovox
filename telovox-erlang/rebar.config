%% Description: Rebar3 Erlang build configuration for Telovox Media Engine.
%% ============================================================================

{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.10.0"},
    {jiffy, "1.1.1"}
]}.

{shell, [
    {apps, [telovox_erlang]}
]}.

{relx, [
    {release, {telovox_erlang, "0.1.0"}, [telovox_erlang, sasl]},
    {mode, dev},
    {include_erts, false},
    {extended_start_script, true}
]}.
